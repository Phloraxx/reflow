# Install as /etc/reflow/webhook.env with mode 0600.
REFLOW_POSTGRES_DSN=
REFLOW_RAZORPAY_WEBHOOK_MODE=enabled
REFLOW_RAZORPAY_ACCOUNT_ID=
REFLOW_RAZORPAY_EVIDENCE_ORIGIN=
REFLOW_RAZORPAY_WEBHOOK_SECRET=
# Keep populated only during a controlled secret-rotation window.
REFLOW_RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
