# Install as /etc/reflow/control-tower.env with mode 0600.
REFLOW_POSTGRES_DSN=
REFLOW_AUTH_MODE=cloudflare_access
REFLOW_CF_ACCESS_ISSUER=
REFLOW_CF_ACCESS_AUD=
REFLOW_AUTHZ_POLICY=/etc/reflow/authz.json
# Enable only after assigning exact-scope case_operator grants.
REFLOW_CASE_WORKFLOW_WRITES=disabled
REFLOW_EVALUATION_ROOT=/opt/reflow/current/data/eval/gate17
REFLOW_FINAL_EVALUATION_SUMMARY=/opt/reflow/current/data/eval/gate19/final-summary.json
REFLOW_WEB_DIST=/opt/reflow/current/web/dist

# Optional local-only Prometheus scrape bearer token (32+ bytes).
REFLOW_METRICS_TOKEN=
