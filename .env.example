# Gate 17/18 local application state and read-only control tower.
REFLOW_POSTGRES_DSN=
REFLOW_EVALUATION_ROOT=data/eval/gate17
REFLOW_FINAL_EVALUATION_SUMMARY=data/eval/gate19/final-summary.json
REFLOW_WEB_DIST=web/dist

# Logical PostgreSQL recovery drill. Restore DSN must target a separate empty database.
REFLOW_RESTORE_POSTGRES_DSN=
REFLOW_PG_DUMP_BIN=pg_dump
REFLOW_PG_RESTORE_BIN=pg_restore

# Human Control Tower authentication. Disabled is synthetic/local-reviewer only.
REFLOW_AUTH_MODE=disabled
REFLOW_CF_ACCESS_ISSUER=
REFLOW_CF_ACCESS_AUD=
REFLOW_AUTHZ_POLICY=

# Optional OpenAI-backed Gate 12 / Gate 16 integrations.
# The deterministic financial core does not require these credentials.
OPENAI_API_KEY=
REFLOW_ADAPTER_MODEL=
REFLOW_INVESTIGATION_MODEL=

# Optional real Razorpay acceptance run. Use Test Mode keys first.
# Never commit populated values or acceptance raw payloads.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REFLOW_RAZORPAY_ACCOUNT_ID=

# Dedicated public Razorpay webhook service. Disabled unless explicitly enabled.
REFLOW_RAZORPAY_WEBHOOK_MODE=disabled
REFLOW_RAZORPAY_EVIDENCE_ORIGIN=
REFLOW_RAZORPAY_WEBHOOK_SECRET=
REFLOW_RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
