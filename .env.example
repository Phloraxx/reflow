# ReFlow deterministic core requires no external financial credentials.
REFLOW_ENV=development
REFLOW_RANDOM_SEED=20260829

# Gate 17/18 local application state and read-only control tower.
REFLOW_POSTGRES_DSN=
REFLOW_EVALUATION_ROOT=data/eval/gate17
REFLOW_FINAL_EVALUATION_SUMMARY=data/eval/gate19/final-summary.json
REFLOW_WEB_DIST=web/dist

# Optional frontend default. A ?scope=... URL value takes precedence.
VITE_REFLOW_SCOPE_ID=

# Optional provider/model integrations. Never commit real secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AI_PROVIDER=
AI_API_KEY=
